<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/root" android:layout_width="match_parent" android:layout_height="match_parent"
    android:background="@drawable/widget_bg" android:orientation="horizontal" android:gravity="center_vertical" android:paddingHorizontal="12dp">
    <TextView android:id="@+id/name" android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content"
        android:textColor="#FFFFFF" android:textSize="14sp" android:singleLine="true" android:ellipsize="end" />
    <TextView android:id="@+id/state" android:layout_width="wrap_content" android:layout_height="wrap_content"
        android:layout_marginStart="8dp" android:textSize="13sp" android:textStyle="bold" />
</LinearLayout>
